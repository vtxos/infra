# What a release ships, and what the dev enclave image is built from. Public sources; each artifact
# is refused unless its sha256 matches.
#
# The cosigner: a release of vtxos/cosigner and the sha256 of its cosigner.wasm. MerlinPlatform's
# Cargo.toml must depend on the same release tag: the platform and the cosigner speak one escrow
# protocol, so the release refuses to ship two sides of it from different releases.
COSIGNER_RELEASE=v0.1.0
COSIGNER_SHA256=ba4976e0b547e9e342fca273e1cd78d2426d0df55e2ea5d9761b6428b86889cf
MERLINPLATFORM_REV=209d2ab6da7cef05fc37004858685764ad260654

# The dev enclave image's runtime (dev-enclave/): a dev bundle release of vtxos/enclave-runtime,
# made by its "Publish a dev enclave" workflow with no image options, and its tarball's sha256.
DEV_ENCLAVE_RELEASE=dev-enclave-dev-c4a0b96
DEV_ENCLAVE_SHA256=32567c86f5dc1b85652e4c6c5d1cf7ee41fdb4472793808ec1160405140cc255
