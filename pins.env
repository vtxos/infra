# What a release ships, and what the dev enclave image is built from. Public sources; each artifact
# is refused unless its sha256 matches.
#
# The cosigner: a release of vtxos/cosigner and the sha256 of its cosigner.wasm. MerlinPlatform's
# Cargo.toml must depend on the same release tag: the platform and the cosigner speak one escrow
# protocol, so the release refuses to ship two sides of it from different releases.
COSIGNER_RELEASE=v0.1.1
COSIGNER_SHA256=e3d704c32309a178d64963bfac328e3b7cd80ee3364cd6fac69e9dd03b364889
MERLINPLATFORM_REV=e951587492a25eee527c21d01e0d6b60fe21a0ce

# The dev enclave image's runtime (dev-enclave/): the vtxos/runtime commit dev-enclave/build.sh
# packs its QEMU dev bundle from, with no image options. A full hash: it names the code exactly.
DEV_RUNTIME_REV=bf5f8044691dca05b77faf6754be626254a49261
